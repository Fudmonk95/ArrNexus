TZ=Europe/London
PUID=1000
PGID=1000

# Persistent MediaStack config/state.
STACK_ROOT=/opt/arrnexus-mediastack
MEDIASTACK_STATE_DIR=/opt/arrnexus-mediastack/state

# Preserve the currently working Zurg mount namespace exactly.
ZURG_MOUNT_ROOT=/zurg_mnt
ZURG_CACHE_DIR=/mnt/appdata/zurg-rclone-cache
LEGACY_CONFIG_ROOT=/home/renegademonk/docker

ARRNEXUS_PORT=8484
STACK_AGENT_PORT=8787
ZURG_PORT=9999
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
PROWLARR_PORT=9696
SEERR_PORT=5055
JELLYFIN_PORT=8096
WHISPARR_PORT=6969
BAZARR_PORT=6767
NEUTARR_PORT=9705
MAINTAINERR_PORT=6246
PROFILARR_PORT=6869
HOMARR_PORT=7575

ARRNEXUS_SESSION_SECRET=change-me-before-production
ARRNEXUS_HTTPS_ONLY=false

# MediaStack control plane. Keep write actions locked until the guided adoption
# plan has been reviewed and one low-risk update/rollback has been validated.
MEDIASTACK_WRITE_ENABLED=false
MEDIASTACK_AGENT_TOKEN=change-me-to-a-long-random-secret
# Empty means every adopted/watched service may receive an authenticated write.
# During first-write testing use a narrow value such as: homarr,bazarr
MEDIASTACK_WRITE_ALLOWLIST=
MEDIASTACK_STABILIZATION_SECONDS=10
MEDIASTACK_HEALTH_TIMEOUT_SECONDS=120

# Optional authenticated GHCR access. Needed for private/sponsor images such as
# Zurg when the registry does not permit anonymous digest checks/pulls.
GHCR_USERNAME=
GHCR_TOKEN=

# Fresh-install-only Lidarr PostgreSQL defaults. Existing installations should
# be adopted in place with their current database/config before consolidation.
LIDARR_POSTGRES_IMAGE=postgres:16
LIDARR_POSTGRES_DB=lidarr
LIDARR_POSTGRES_USER=lidarr
LIDARR_POSTGRES_PASSWORD=change-me-before-fresh-install

# Match the live Jellyfin container. These values keep /dev/dri access working
# after migration from its current standalone Compose project.
JELLYFIN_UID=1001
JELLYFIN_GID=1001
JELLYFIN_VIDEO_GID=44
JELLYFIN_RENDER_GID=104

# Match the images currently proven on this server. Pin/override when desired.
ZURG_IMAGE=ghcr.io/debridmediamanager/zurg:latest
SONARR_IMAGE=lscr.io/linuxserver/sonarr:latest
RADARR_IMAGE=lscr.io/linuxserver/radarr:latest
LIDARR_IMAGE=lscr.io/linuxserver/lidarr:latest
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:latest
SEERR_IMAGE=snapetech/seerrng:latest
JELLYFIN_IMAGE=ghcr.io/jellyfin/jellyfin:10.11.11
WHISPARR_IMAGE=ghcr.io/thespad/whisparr:v3.5.0-release.1585-spad50
BAZARR_IMAGE=lscr.io/linuxserver/bazarr:latest
NEUTARR_IMAGE=iampuid0/neutarr:1.11.1
MAINTAINERR_IMAGE=ghcr.io/maintainerr/maintainerr:3.27.0
PROFILARR_IMAGE=ghcr.io/dictionarry-hub/profilarr:develop
PROFILARR_PARSER_IMAGE=ghcr.io/dictionarry-hub/profilarr-parser:develop
HOMARR_IMAGE=ghcr.io/homarr-labs/homarr:latest

# v13.4.0 was recovered from the live server and remains the source baseline for
# MediaStack v1 until the control-plane build receives its own release tag.
ARRNEXUS_IMAGE=arrnexus:v13.4.0
