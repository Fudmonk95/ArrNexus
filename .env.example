# ArrNexus v12.0.0 - personal server configuration
# API keys can also be entered in the ArrNexus UI after first boot.

# Persistent data used by the Portainer/Docker deployment on this server.
ARRNEXUS_DATA_DIR=/mnt/appdata/arrnexus/data
DB_PATH=/data/router.db

# Optional HTTPS hostname. Required for Spotify linking when ArrNexus is not
# being accessed through localhost/127.0.0.1.
# Example: https://arrnexus.example.com
ARRNEXUS_PUBLIC_URL=

# Zurg source library and cache visibility.
ZURG_ROOT=/zurg_mnt/zurg
ZURG_URL=http://host.docker.internal:9999
ZURG_CACHE_DIR=/mnt/appdata/zurg-rclone-cache
ZURG_CACHE_PATH=/host/zurg-rclone-cache

RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=
LIDARR_URL=http://host.docker.internal:8686
LIDARR_API_KEY=
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=
SEERR_URL=http://host.docker.internal:5055
SEERR_API_KEY=

# Optional. If left blank, ArrNexus stores a generated session secret in /data.
ARRNEXUS_SESSION_SECRET=
ARRNEXUS_HTTPS_ONLY=false
