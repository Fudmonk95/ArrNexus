APP_PORT=8484
APP_NAME=ArrNexus
APP_USERNAME=admin
APP_PASSWORD=replace-me
SESSION_SECRET=replace-with-a-long-random-string

# DUMB filesystem namespace
DUMB_ROOT=/mnt/debrid
SOURCE_ROOT=/mnt/debrid/decypharr/__all__
RADARR_PROCESS_MATCH=/opt/radarr/Radarr/Radarr
RADARR_DATA_MATCH=--data=/radarr/nzbdav

# Main connections. They can also be changed later in ArrNexus → Connections.
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=
RADARR_QUALITY_PROFILE_NAME=Any HD
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=
SONARR_QUALITY_PROFILE_NAME=Any
LIDARR_URL=http://host.docker.internal:8686
LIDARR_API_KEY=
LIDARR_QUALITY_PROFILE_NAME=Any
LIDARR_METADATA_PROFILE_NAME=Standard
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=

# Public/no-personal-account music discovery.
MUSICBRAINZ_BASE=https://musicbrainz.org/ws/2
LISTENBRAINZ_BASE=https://api.listenbrainz.org
MUSIC_USER_AGENT=ArrNexus/2.0 (self-hosted media manager)
PUBLIC_MUSIC_COUNTRY=GB
ENABLE_ITUNES_SEARCH=true

RADARR_DEFAULT_ROOT=/mnt/debrid/nzbdav-symlinks/radarr-nzbdav
RADARR_KIDS_ROOT=/mnt/debrid/nzbdav-symlinks/radarr-kids-nzbdav
RADARR_CHRISTMAS_ROOT=/mnt/debrid/nzbdav-symlinks/radarr-christmas-nzbdav
RADARR_HALLOWEEN_ROOT=/mnt/debrid/nzbdav-symlinks/radarr-halloween-nzbdav
RADARR_EASTER_ROOT=/mnt/debrid/nzbdav-symlinks/radarr-easter-nzbdav
SONARR_DEFAULT_ROOT=/mnt/debrid/nzbdav-symlinks/sonarr-nzbdav
SONARR_KIDS_ROOT=/mnt/debrid/nzbdav-symlinks/sonarr-kids-nzbdav
SONARR_NETFLIX_ROOT=/mnt/debrid/nzbdav-symlinks/sonarr-netflix-nzbdav
SONARR_DISNEY_ROOT=/mnt/debrid/nzbdav-symlinks/sonarr-disneyplus-nzbdav
SONARR_AMAZON_ROOT=/mnt/debrid/nzbdav-symlinks/sonarr-amazon-nzbdav
SONARR_APPLE_ROOT=/mnt/debrid/nzbdav-symlinks/sonarr-appletv-nzbdav
SONARR_BBC_ROOT=/mnt/debrid/nzbdav-symlinks/sonarr-bbc-nzbdav
LIDARR_ROOT=/mnt/debrid/nzbdav-symlinks/lidarr-nzbdav
