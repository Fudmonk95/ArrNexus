# ArrNexus v11 - personal server configuration
# API keys can also be entered in the ArrNexus UI after first boot.

ZURG_URL=http://host.docker.internal:9999

RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=
LIDARR_URL=http://host.docker.internal:8686
LIDARR_API_KEY=
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=
SEERR_URL=http://host.docker.internal:5055
SEERR_API_KEY=

# Optional. If left blank, ArrNexus stores a generated session secret in /data.
ARRNEXUS_SESSION_SECRET=
ARRNEXUS_HTTPS_ONLY=false
